# Copy this file to .env (git-ignored) and fill in real values.

# Groq API key — used by AiDocumentService and AiChatService (lib/core/ai)
# to organize OCR'd document text into suggestions and to answer chat
# questions about saved documents. Get one at https://console.groq.com/keys
# — the AI step is skipped entirely (falls back to OCR-only / "couldn't
# answer that") if this is missing or invalid.
GROQ_API_KEY=your_key_here

# Public Web OAuth client ID used only to request a Google Drive server code.
# The matching client secret belongs exclusively in FastAPI Cloud.
GOOGLE_SERVER_CLIENT_ID=your_web_oauth_client_id_here

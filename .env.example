# Copy this file to .env (git-ignored) and fill in real values.

# OpenRouter API key — used by AiDocumentService (lib/core/ai) to organize
# OCR'd document text into a title/category/summary/expiry suggestion.
# Get one at https://openrouter.ai/keys — the AI step is skipped entirely
# (falls back to OCR-only) if this is missing or invalid.
OPENROUTER_API_KEY=your_key_here

# Public Web OAuth client ID used only to request a Google Drive server code.
# The matching client secret belongs exclusively in FastAPI Cloud.
GOOGLE_SERVER_CLIENT_ID=your_web_oauth_client_id_here

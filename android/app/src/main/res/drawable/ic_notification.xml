<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar/notification small icon. Deliberately separate from
  @mipmap/ic_launcher: Android requires this one to be a flat white
  silhouette on a transparent background (it strips all color down to
  just the alpha channel before drawing it), so the full-color launcher
  icon can't be reused here -- using it anyway is what made the
  notification icon render as a tiny, near-featureless blob. A simple
  document glyph reads fine at the ~24dp size notifications actually
  render it at, matching the launcher icon's "document" motif without
  its fine detail (lines/checkmark/folder cutout), which wouldn't survive
  being this small anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M14,2H6C4.9,2 4,2.9 4,4v16c0,1.1 0.89,2 1.99,2H18c1.1,0 2,-0.9 2,-2V8L14,2zM16,18H8v-2h8V18zM16,14H8v-2h8V14zM13,9V3.5L18.5,9H13z" />
</vector>
